# docs/app-spec/21-testing-quality.md §4.3
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces can be a Markdown line break.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
