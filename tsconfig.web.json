{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "outDir": "node_modules/.cache/tsc/web",
    "tsBuildInfoFile": "node_modules/.cache/tsc/web.tsbuildinfo"
  },
  "include": ["src/renderer/**/*", "src/renderer/**/*.vue", "src/shared/**/*"],
  "vueCompilerOptions": {
    "strictTemplates": true
  }
}
