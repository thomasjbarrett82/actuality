# Copy to .env.test.local (git-ignored) for `npm run test:int` and `npm run test:e2e` against your own server.
# http://localhost:5006 with ACTUAL_TEST_BOOTSTRAP=1 uses a Docker server the tests start themselves.
ACTUAL_TEST_SERVER_URL=https://actual.example.lan:5006
ACTUAL_TEST_PASSWORD=
# PEM file of the CA that signed the server's certificate, if it isn't publicly trusted.
ACTUAL_TEST_CA_CERT=
# 1 sets the password on a fresh server first (CI only).
ACTUAL_TEST_BOOTSTRAP=0
