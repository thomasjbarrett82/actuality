// markdownlint-cli2 (21 §4.5): the default rules, with line length (MD013) off because spec tables
// are wide. No inline HTML: the swatches in theme-palettes.md use Markdown image syntax. CHANGELOG.md is
// generated by commit-and-tag-version, which repeats its section headings in every release.
{
  "config": {
    "default": true,
    "MD013": false,
  },
  "ignores": ["**/node_modules/**", "references/**", "website/build/**", "CHANGELOG.md"],
}
